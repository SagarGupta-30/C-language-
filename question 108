#include <stdio.h>

int main() {
    int N;
    scanf("%d", &N);

    int arr[N];
    for(int i = 0; i < N; i++) {
        scanf("%d", &arr[i]);

        if(arr[i] < 0)
            arr[i] = 0;   // replace negative with 0
    }

    // Print updated array
    for(int i = 0; i < N; i++) {
        printf("%d ", arr[i]);
    }

    return 0;
}
