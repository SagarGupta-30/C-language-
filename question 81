#include <stdio.h>
#include <limits.h>

int main() {
    long long n;
    scanf("%lld", &n);

    /* Out of range check */
    if (n < INT_MIN || n > INT_MAX) {
        printf("Out of Range");
        return 0;
    }

    int x = (int)n;

    /* Divisible by 4 using bitwise operation */
    if ((x & 3) == 0) {
        printf("Divisible");
    } else {
        printf("Not Divisible");
    }

    return 0;
}
