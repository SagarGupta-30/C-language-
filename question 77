#include <stdio.h>

long long gcd(long long a, long long b) {
    while (b != 0) {
        long long temp = b;
        b = a % b;
        a = temp;
    }
    return a;
}

int main() {
    long long A, B;
    scanf("%lld %lld", &A, &B);

    long long g = gcd(A, B);
    long long lcm = (A / g) * B;  // safer to avoid overflow

    printf("%lld", lcm);
    return 0;
}
