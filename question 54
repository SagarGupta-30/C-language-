#include <stdio.h>
#include <math.h>

int main() {
    int a, b, c;
    scanf("%d %d %d", &a, &b, &c);

    double D = (double)b * b - 4.0 * a * c;

    if (D > 0) {
        double root1 = (-b + sqrt(D)) / (2.0 * a);
        double root2 = (-b - sqrt(D)) / (2.0 * a);

        printf("Roots: %.2f, %.2f\n", root1, root2);
        printf("Type: Real and Distinct");
    }
    else if (D == 0) {
        double root = -b / (2.0 * a);

        printf("Roots: %.2f, %.2f\n", root, root);
        printf("Type: Real and Equal");
    }
    else {
        double realPart = -b / (2.0 * a);
        double imaginaryPart = sqrt(-D) / (2.0 * a);

        printf("Roots: %.2f + %.2fi, %.2f - %.2fi\n",
               realPart, imaginaryPart, realPart, imaginaryPart);
        printf("Type: Complex");
    }

    return 0;
}
