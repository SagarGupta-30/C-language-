#include <stdio.h>

int main() {
    long long num;
    scanf("%lld", &num);

    long long temp = num;
    int count = 0;

    while (temp > 0) {
        int digit = temp % 10;

        if (num % digit == 0) {
            count++;
        }

        temp /= 10;
    }

    printf("%d", count);
    return 0;
}
