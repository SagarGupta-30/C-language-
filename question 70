#include <stdio.h>

int main() {
    int n;
    scanf("%d", &n);

    if (n < 2) {
        printf("Shape Not Possible");
        return 0;
    }

    /* Special case for n = 2 */
    if (n == 2) {
        printf("*\n");
        printf("**\n");
        printf("*");
        return 0;
    }

    /* Top part */
    printf("*\n");
    printf("**\n");

    /* Upper widening */
    for (int i = 3; i <= n; i++) {
        printf("*");
        for (int space = 1; space <= i - 2; space++) {
            printf(" ");
        }
        printf("*\n");
    }

    /* Lower narrowing */
    for (int i = n - 1; i >= 3; i--) {
        printf("*");
        for (int space = 1; space <= i - 2; space++) {
            printf(" ");
        }
        printf("*\n");
    }

    /* Bottom part */
    printf("**\n");
    printf("*");

    return 0;
}
