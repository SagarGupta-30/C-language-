#include <stdio.h>

int main() {
    int N;
    scanf("%d", &N);

    int arr[N];
    for(int i = 0; i < N; i++)
        scanf("%d", &arr[i]);

    int K;
    scanf("%d", &K);

    int lastIndex = -1;   // assume not found

    // Traverse from left to right and keep updating index
    for(int i = 0; i < N; i++) {
        if(arr[i] == K)
            lastIndex = i;   // keeps storing latest match
    }

    printf("%d", lastIndex);
    return 0;
}
