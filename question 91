#include <stdio.h>
#include <limits.h>

int main() {
    int N;
    scanf("%d", &N);

    int arr[N];
    int max = INT_MIN, min = INT_MAX;

    for(int i = 0; i < N; i++) {
        scanf("%d", &arr[i]);

        if(arr[i] > max)
            max = arr[i];
        if(arr[i] < min)
            min = arr[i];
    }

    printf("%d %d", max, min);
    return 0;
}
