#include <stdio.h>

int main() {
    int N;
    scanf("%d", &N);

    long long evenSum = 0, oddSum = 0;
    int x;

    for(int i = 0; i < N; i++) {
        scanf("%d", &x);

        if(i % 2 == 0)
            evenSum += x;   // even index
        else
            oddSum += x;    // odd index
    }

    printf("%lld", evenSum - oddSum);
    return 0;
}
