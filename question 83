#include <stdio.h>

int main() {
    int n;
    scanf("%d", &n);

    if(n <= 0) {      // covers n = 0
        printf(".");
        return 0;
    }

    int lastOdd = 2 * n - 1;

    for(int i = lastOdd; i >= 1; i -= 2) {
        if(i == 1)
            printf("1.");   // last number + dot, NO SPACE
        else
            printf("%d ", i);
    }

    return 0;
}
