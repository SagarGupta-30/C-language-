#include <stdio.h>

int main() {
    int n;
    scanf("%d", &n);

    if (n <= 0) {
        return 0;
    }

    long long term = 1;
    printf("<");

    for (int i = 1; i <= n; i++) {
        printf("%lld", term);
        if (i < n) {
            printf(" ");
        }
        term = term * 2;
    }

    printf(">");
    return 0;
}
