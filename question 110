#include <stdio.h>

int findSecondLargest(int arr[], int n) {
    if (n < 2)
        return -1;

    long long largest = -1000000001;
    long long secondLargest = -1000000001;

    for (int i = 0; i < n; i++) {
        if (arr[i] > largest) {
            secondLargest = largest;
            largest = arr[i];
        }
        else if (arr[i] > secondLargest && arr[i] < largest) {
            secondLargest = arr[i];
        }
    }

    if (secondLargest == -1000000001)
        return -1;

    return (int)secondLargest;
}

int main() {
    int n;
    scanf("%d", &n);

    int arr[n];
    for (int i = 0; i < n; i++)
        scanf("%d", &arr[i]);

    int result = findSecondLargest(arr, n);

    printf("%d", result);

    return 0;
}
