#include <stdio.h>
#include <string.h>
#include <math.h>
#include <stdlib.h>

int main() {

    int num;
    scanf("%d ", &num);
        
           if(num<=1){
               printf("None\n");
               return 0;
           }
    for(int i=2; i<=sqrt(num);++i){
            if(num % i==0){
                printf("Composite\n");
                return 0;
            }
            }
    printf("Prime\n");
        
    return 0;
}
