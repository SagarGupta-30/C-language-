#include <stdio.h>

int main() {
    int n;
    scanf("%d", &n);

    /* Butterfly not possible for n <= 1 */
    if (n <= 1) {
        printf("Shape Not Possible");
        return 0;
    }

    /* Upper half */
    for (int i = 1; i <= n; i++) {
        for (int j = 1; j <= i; j++) {
            printf("*");
        }

        for (int space = 1; space <= 2 * (n - i); space++) {
            printf(" ");
        }

        for (int j = 1; j <= i; j++) {
            printf("*");
        }

        printf("\n");
    }

    /* Lower half */
    for (int i = n - 1; i >= 1; i--) {
        for (int j = 1; j <= i; j++) {
            printf("*");
        }

        for (int space = 1; space <= 2 * (n - i); space++) {
            printf(" ");
        }

        for (int j = 1; j <= i; j++) {
            printf("*");
        }

        printf("\n");
    }

    return 0;
}
